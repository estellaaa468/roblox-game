local button = script.Parent
local terminalFrame = button.Parent
local windowFrame = terminalFrame:WaitForChild("settingsFrame")

button.MouseEnter:Connect(function()
	if windowFrame.Visible then
		return
	end

	button.Text = ">> SETTINGS_"
	button.TextColor3 = Color3.fromRGB(0, 185, 0)
end)

button.MouseLeave:Connect(function()
	if windowFrame.Visible then
		return
	end

	button.Text = "> SETTINGS"
	button.TextColor3 = Color3.fromRGB(0, 170, 0)
end)

button.MouseButton1Click:Connect(function()
	button.Text = "> SETTINGS"
	if windowFrame.Visible then
		return
	end

	windowFrame.Visible = true
	terminalFrame.ClickBlocker.Visible = true
	print("Window visible:", windowFrame.Visible)
end)



